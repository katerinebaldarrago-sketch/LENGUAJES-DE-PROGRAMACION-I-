Algoritmo OperacionesBasicas
    Definir a, b, suma, resta, multiplicacion Como Entero
    
    Escribir "Ingrese el primer número:"
    Leer a
    
    Escribir "Ingrese el segundo número:"
    Leer b
    
    suma <- a + b
    resta <- a - b
    multiplicacion <- a * b
	division <- a / b
    
    Escribir "Suma: ", suma
    Escribir "Resta: ", resta
    Escribir "Multiplicación: ", multiplicacion
	Escribir "Division: ", division
FinAlgoritmo