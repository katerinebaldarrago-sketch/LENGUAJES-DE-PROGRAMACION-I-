Algoritmo ConversionSegundosAHoras
    Definir segundos, minutos, hora Como Real
    
    Escribir "Ingrese la cantidad de segundos:"
    Leer segundos
	
	hora <- segundos / 3600
	minutos <- segundos / 60
	
    Escribir "La cantidad de horas es: ", hora
    
    Escribir "La cantidad de minutos es:  ", minutos
FinAlgoritmo




