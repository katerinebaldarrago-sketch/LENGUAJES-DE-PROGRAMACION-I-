Algoritmo PitagorasNormal
    Definir CA, CO, hipotenusa Como Real
    
    Escribir "Ingrese el Cateto Adyacente (CA):"
    Leer CA
    
    Escribir "Ingrese el Cateto Opuesto (CO):"
    Leer CO
    
    hipotenusa <- raiz(CA * CA + CO * CO)
    
    Escribir "La hipotenusa es: ", hipotenusa
FinAlgoritmo